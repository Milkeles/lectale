// One Worker serves the Flutter web build and the API on the same host
// (ADR-0002). Only /api/* runs code; every other request is a free static
// asset request.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lectale",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "../flutter_client/build/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
