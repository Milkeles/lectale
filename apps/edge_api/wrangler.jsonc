// The landing page and Flutter web app use static assets (ADR-0014,
// V4-CACHE-04). API routes run the Worker first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lectale",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./build/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "IMPORT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "PREVIEW_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 180, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
