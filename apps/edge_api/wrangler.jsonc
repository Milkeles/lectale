// One Worker serves the Flutter web build and the API on the same host
// (ADR-0002). Only /api/* runs code; every other request is a free static
// asset request.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lectale",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "../flutter_client/build/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "ratelimits": [
    {
      "name": "IMPORT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "PREVIEW_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 180, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
