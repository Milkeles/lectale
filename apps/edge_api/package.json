{
  "name": "@lectale/edge-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run compile:schemas && wrangler dev",
    "types": "wrangler types src/worker-configuration.d.ts",
    "compile:schemas": "node scripts/compile-schemas.mjs",
    "typecheck": "npm run compile:schemas && wrangler types src/worker-configuration.d.ts > /dev/null && tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "npm run compile:schemas && vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.19",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
