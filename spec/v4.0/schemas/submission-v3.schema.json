{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-course:submission-v3",
  "title": "Finalized student submission v3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "submissionId": {
      "type": "string",
      "pattern": "^sub_[a-z0-9]{16,40}$"
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "studentKey": {
      "type": "string",
      "pattern": "^stu_[a-z0-9]{16,40}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "submitted"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "courseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "storage": {
            "const": "github-lfs",
            "description": "File is in instructor-owned Git LFS, and must be committed as a pointer in a private submissions Git repository."
          },
          "pointerPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "name",
          "mediaType",
          "sizeBytes",
          "sha256",
          "storage",
          "pointerPath"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "submissionId",
    "courseId",
    "assignmentId",
    "studentKey",
    "attempt",
    "status",
    "submittedAt",
    "courseCommit",
    "files"
  ],
  "additionalProperties": false
}
