{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-course:grade-v3",
  "title": "Private grade export v3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "gradeId": {
      "type": "string",
      "pattern": "^grd_[a-z0-9]{16,40}$"
    },
    "submissionId": {
      "type": "string",
      "pattern": "^sub_[a-z0-9]{16,40}$"
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "studentKey": {
      "type": "string",
      "pattern": "^stu_[a-z0-9]{16,40}$"
    },
    "status": {
      "enum": [
        "graded",
        "returned",
        "excused"
      ]
    },
    "score": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      ]
    },
    "maxPoints": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "feedback": {
      "type": "string",
      "maxLength": 10000
    },
    "graderKey": {
      "type": "string",
      "pattern": "^staff_[a-z0-9]{16,40}$"
    },
    "gradedAt": {
      "type": "string",
      "format": "date-time"
    },
    "courseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "enum": [
        "manual",
        "automatic",
        "hybrid-override"
      ]
    },
    "automaticJobId": {
      "type": "string",
      "maxLength": 120
    }
  },
  "required": [
    "schemaVersion",
    "gradeId",
    "submissionId",
    "courseId",
    "assignmentId",
    "studentKey",
    "status",
    "score",
    "maxPoints",
    "graderKey",
    "gradedAt",
    "courseCommit",
    "revision",
    "source"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "graded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "else": {
        "properties": {
          "score": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "enum": [
              "automatic",
              "hybrid-override"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "automaticJobId"
        ]
      }
    }
  ]
}
