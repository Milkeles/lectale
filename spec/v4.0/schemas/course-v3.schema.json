{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portable-course:course-v3",
  "title": "Portable course manifest v3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "course": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "license": {
          "type": "string",
          "maxLength": 100
        },
        "tags": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 80
          }
        },
        "authors": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "level": {
          "enum": [
            "introductory",
            "intermediate",
            "advanced",
            "mixed"
          ]
        },
        "cover": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "maxLength": 500
        },
        "publishedAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "language",
        "version"
      ],
      "additionalProperties": false
    },
    "outline": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/module"
          },
          {
            "$ref": "#/$defs/lesson"
          },
          {
            "$ref": "#/$defs/assignmentRef"
          }
        ]
      }
    },
    "assignments": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/assignment"
      }
    },
    "display": {
      "type": "object",
      "properties": {
        "showEstimatedDuration": {
          "type": "boolean"
        },
        "showFileDownloads": {
          "type": "boolean"
        },
        "themeAccent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "course",
    "outline",
    "assignments"
  ],
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "module"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "children": {
          "type": "array",
          "maxItems": 250,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/module"
              },
              {
                "$ref": "#/$defs/lesson"
              },
              {
                "$ref": "#/$defs/assignmentRef"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "children"
      ],
      "additionalProperties": false
    },
    "lesson": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "lesson"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "recordedAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "resources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/resource"
          }
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "resources"
      ],
      "additionalProperties": false
    },
    "assignmentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "assignment"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "id",
        "assignmentId"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "type": {
          "enum": [
            "auto",
            "pdf",
            "notebook",
            "markdown",
            "image",
            "video",
            "audio",
            "text",
            "code",
            "file",
            "folder",
            "external"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "provider": {
          "enum": [
            "youtube",
            "vimeo",
            "external"
          ]
        },
        "recursive": {
          "type": "boolean"
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "preview": {
          "type": "boolean"
        },
        "download": {
          "type": "boolean"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "display": {
          "enum": [
            "inline",
            "attachment",
            "auto"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "path"
              ],
              "not": {
                "required": [
                  "url"
                ]
              }
            },
            {
              "required": [
                "url"
              ],
              "not": {
                "required": [
                  "path"
                ]
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "folder"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "url"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "recursive"
                  ]
                },
                {
                  "required": [
                    "maxEntries"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "external"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "video"
              }
            },
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            },
            "required": [
              "type",
              "url"
            ]
          },
          "then": {
            "required": [
              "provider"
            ]
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "materials": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "submission": {
          "type": "object",
          "properties": {
            "allowedExtensions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\.[a-z0-9]{1,12}$"
              }
            },
            "maxFileBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5368709120
            },
            "maxAttemptBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5368709120
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxTotalBytesPerStudent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            },
            "openAt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            },
            "dueAt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            },
            "closeAt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            },
            "allowLate": {
              "type": "boolean"
            }
          },
          "required": [
            "allowedExtensions",
            "maxFileBytes",
            "maxAttemptBytes",
            "maxFiles",
            "maxAttempts"
          ],
          "additionalProperties": false
        },
        "grading": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "automatic",
                "hybrid"
              ]
            },
            "maxPoints": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "allowRevisionAfterGrade": {
              "type": "boolean"
            },
            "automatic": {
              "type": "object",
              "properties": {
                "provider": {
                  "const": "github-actions"
                },
                "workflowPath": {
                  "type": "string",
                  "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$",
                  "maxLength": 220
                },
                "trigger": {
                  "enum": [
                    "on-submit",
                    "manual"
                  ]
                },
                "resultFormat": {
                  "const": "course-grading-result/v1"
                },
                "timeoutMinutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "maxRunsPerAttempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "releasePolicy": {
                  "enum": [
                    "review-required",
                    "auto-release"
                  ]
                }
              },
              "required": [
                "provider",
                "workflowPath",
                "trigger",
                "resultFormat",
                "timeoutMinutes",
                "maxRunsPerAttempt",
                "releasePolicy"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "mode",
            "maxPoints"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": [
                      "automatic",
                      "hybrid"
                    ]
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "automatic"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "automatic"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "hybrid"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "automatic": {
                    "properties": {
                      "releasePolicy": {
                        "const": "review-required"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "releaseAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "materials",
        "submission",
        "grading"
      ],
      "additionalProperties": false
    }
  }
}
