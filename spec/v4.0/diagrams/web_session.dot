digraph Auth {graph [rankdir=TB,bgcolor=white, nodesep=0.28, ranksep=0.45, fontname="DejaVu Sans", pad=0.25];
 node [shape=box, style="rounded,filled", fillcolor="#F4F7FC", color="#36516D", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.11"];
 edge [color="#60758C", fontname="DejaVu Sans", fontsize=10, arrowsize=.7];
 A[label="Sign in using Firebase SDK\nin-memory during login exchange"];
 B[label="POST /api/auth/session\nFirebase ID token + Origin check"];
 C[label="Worker checks JWT signature/claims\ncreates random opaque 256-bit session"];
 D[label="D1 stores HASH(session) + TTL\nNo raw token stored"];
 E[label="Set-Cookie: __Host-course_session\nSecure; HttpOnly; SameSite=Lax; Path=/"];
 F[label="Subsequent same-origin API requests\nCookie + CSRF token on mutations"];
 G[label="Worker checks session hash, role,\norigin, CSRF and state"];
 A->B->C->D->E->F->G;
}