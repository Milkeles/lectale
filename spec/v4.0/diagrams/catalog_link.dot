digraph G {graph [rankdir=LR, bgcolor="white", pad=.3, nodesep=.42, ranksep=.5]; node [fontname="Liberation Sans", shape=box, style="rounded,filled", fillcolor="#F2F5FA", color="#8A9BAD", fontsize=12, margin="0.18,0.11"]; edge [fontname="Liberation Sans", fontsize=10, color="#60768D", arrowsize=.75];
student [label="Student / Guest\nFlutter web or mobile",fillcolor="#E8F1FA"];
url [label="Open GitHub repo URL\nCORE: no catalog",fillcolor="#E3F4ED"];
cat [label="Optional Browse catalog\nD1 public-safe snapshots",fillcolor="#F7EEDD"];
preview [label="Validate + preview\nREADME + course.yaml @ SHA"];
view [label="In-app viewers\nPDF / video / notebook / files"];
login [label="Firebase login + D1 entitlement\nONLY for managed restricted actions"];
student -> url; student -> cat;url -> preview;cat -> preview [label="managed, opted-in only"];preview -> view;preview -> login [label="submit / paid / private",style=dashed];
}