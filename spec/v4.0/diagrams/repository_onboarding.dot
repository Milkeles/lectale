digraph Onboard {graph [rankdir=TB,bgcolor=white, nodesep=0.28, ranksep=0.45, fontname="DejaVu Sans", pad=0.25];
 node [shape=box, style="rounded,filled", fillcolor="#F4F7FC", color="#36516D", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.11"];
 edge [color="#60758C", fontname="DejaVu Sans", fontsize=10, arrowsize=.7];
 A[label="Instructor pastes GitHub URL"];
 B[label="Resolve repository ID\nRead public manifest if available"];
 C[label="Read-only preview / report validation errors"];
 D[label="Firebase login + GitHub user authorization\nVerify administration of exact repository"];
 E[label="Install/select GitHub App access\nExplicit selected repos and permissions"];
 F[label="course.yaml exists?",shape=diamond,fillcolor="#FFF4D4"];
 G[label="Validate v2 schema and semantic references"];
 H[label="With consent, write minimal scaffold\nNo overwrites, idempotent commit"];
 I[label="Choose/create private submission repository\nOnly if supported & explicitly authorized"];
 J[label="Save D1 repo IDs/policy, pinned SHA\nPublish only after validation"];
 A->B->C->D->E->F;F->G[label="yes"];F->H[label="no"];H->G;G->I->J;
}