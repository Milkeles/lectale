root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, but none are used here.
trim_trailing_whitespace = true

[{Makefile,justfile}]
indent_size = 4

[*.{kt,kts,gradle}]
indent_size = 4

[*.{cc,cpp,h}]
indent_size = 2
